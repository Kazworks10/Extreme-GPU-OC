#version 450
// gpuoc deterministic stress kernel.
//
// Integer-only so the result is bit-exact on every conforming GPU. Each pass
// reads a pseudo-random element of the source buffer (memory stress) and runs
// an LCG/xorshift chain (ALU stress); passes ping-pong between two buffers.
// On the last pass every invocation folds its result into an order-independent
// checksum (XOR and wrapping sum). kernel_reference.cpp is the CPU twin.
//
// Regenerate kernel_spv.inc with tools/gen_spirv.py after editing.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };
layout(std430, binding = 2) buffer Sum { uint sum_xor; uint sum_add; uint pad0; uint pad1; };

layout(push_constant) uniform Params {
  uint n_mask;  // element count - 1 (count is a power of two)
  uint pass;
  uint iters;
  uint flags;   // bit 0: first pass (generate input), bit 1: last pass (accumulate)
} pc;

uint mix32(uint x) {
  x ^= x >> 16;
  x *= 0x7feb352du;
  x ^= x >> 15;
  x *= 0x846ca68bu;
  x ^= x >> 16;
  return x;
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  bool first = (pc.flags & 1u) != 0u;
  uint j = mix32(i + pc.pass * 0x632be5abu) & pc.n_mask;
  uint x = first ? mix32(i ^ 0x9e3779b9u) : src[i];
  uint y = first ? mix32(j ^ 0x9e3779b9u) : src[j];
  for (uint k = 0u; k < pc.iters; ++k) {
    x = x * 1664525u + 1013904223u;
    x ^= (x >> 13) ^ y;
    y = (y << 5) | (y >> 27);
  }
  dst[i] = x;
  if ((pc.flags & 2u) != 0u) {
    atomicXor(sum_xor, x);
    atomicAdd(sum_add, x ^ i);
  }
}
